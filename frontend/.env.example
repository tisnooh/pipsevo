REACT_APP_BACKEND_URL=http://localhost:8000
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
REACT_APP_REQUIRE_EMAIL_CONFIRMATION=true
REACT_APP_CONTACT_EMAIL=support@pipsevo.com

# Public UI switch only. The backend has a separate server-side switch and
# remains the authority. Keep false until the real provider is operational.
REACT_APP_MT5_AUTO_SYNC_ENABLED=false

# Serverless cron proxy only. Configure these as private Vercel environment
# variables (never REACT_APP_* because browser bundles expose that prefix).
# BACKEND_INTERNAL_URL=https://api.example.com
# CRON_SECRET=replace-with-the-same-backend-secret

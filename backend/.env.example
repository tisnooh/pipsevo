MONGO_URL=mongodb+srv://user:password@example.mongodb.net
DB_NAME=pipsevo
JWT_SECRET=replace-with-a-long-random-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Secret key used only by the backend. Never expose it with a REACT_APP_ prefix.
SUPABASE_SECRET_KEY=sb_secret_your_server_key
# Atlas IA (Anthropic). ATLAS_ANTHROPIC_API_KEY takes priority; the legacy
# EMERGENT_LLM_KEY fallback remains accepted during migration.
ATLAS_ANTHROPIC_API_KEY=
ATLAS_MODEL=claude-sonnet-4-6
ATLAS_TIMEOUT_SECONDS=45
EMERGENT_LLM_KEY=

# MetaTrader 5 automatic sync. Keep OFF until a real provider adapter is
# registered and validated with sandbox credentials.
MT5_AUTO_SYNC_ENABLED=false
MT5_PROVIDER=
MT5_ALLOWED_PLANS=beta,pro
MT5_SYNC_INTERVAL_MINUTES=5
MT5_SYNC_RETRY_ATTEMPTS=3
MT5_SYNC_BACKOFF_SECONDS=1
MT5_MAX_CONNECTION_ATTEMPTS=5
MT5_CONNECTION_ATTEMPT_WINDOW_MINUTES=15
# Comma-separated URL-safe base64 AES-256 keys, ordered by version.
# Generate a 32-byte key outside the repository and store it in the host secret manager.
INTEGRATION_ENCRYPTION_KEYS=
INTEGRATION_ENCRYPTION_KEY_VERSION=1
INTEGRATION_ENABLED_PROVIDERS=ctrader,metaapi,tradelocker,tradovate
INTEGRATION_SYNC_LOCK_MINUTES=10
PUBLIC_API_URL=https://api.example.com/api
FRONTEND_URL=https://pipsevo.vercel.app
CRON_SECRET=replace-with-a-random-server-secret

# PipsEvo email system (Resend). Verify both sender domains before production.
RESEND_API_KEY=re_replace_me
EMAIL_TOKEN_SECRET=replace-with-a-different-long-random-secret
NEWSLETTER_ADMIN_KEY=replace-with-a-long-random-administration-key
AUTH_EMAIL_FROM=PipsEvo Sécurité <securite@auth.your-domain.com>
NEWSLETTER_EMAIL_FROM=PipsEvo <newsletter@updates.your-domain.com>
EMAIL_REPLY_TO=support@your-domain.com

# Rollout flags. A provider is registered only when its flag and every required
# server credential are present. Keep each flag false until its sandbox
# checklist has passed.
CTRADER_SYNC_ENABLED=false
MT5_SYNC_ENABLED=false
MT4_SYNC_ENABLED=false
TRADELOCKER_SYNC_ENABLED=false
TRADOVATE_SYNC_ENABLED=false
NINJATRADER_SYNC_ENABLED=false

# cTrader Open API application (OAuth, read-only account scope).
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=https://api.example.com/api/integrations/oauth/callback

# MetaApi provider token. User MetaTrader passwords are passed only to MetaApi
# when explicitly supplied and are never persisted by PipsEvo.
METAAPI_TOKEN=
METAAPI_DOMAIN=agiliumtrade.agiliumtrade.ai

# TradeLocker has no global user credential. This switch exposes its official
# JWT connection form; per-user passwords are exchanged then discarded.
TRADELOCKER_DEMO_URL=https://demo.tradelocker.com/backend-api
TRADELOCKER_LIVE_URL=https://live.tradelocker.com/backend-api

# Tradovate OAuth application. Leave unset until API access is approved.
TRADOVATE_CLIENT_ID=
TRADOVATE_CLIENT_SECRET=
TRADOVATE_REDIRECT_URI=https://api.example.com/api/integrations/oauth/callback

# Required only when real Stripe billing is implemented server-side.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_ESSENTIAL_PRICE_ID=price_replace_me
STRIPE_PRO_PRICE_ID=price_replace_me
STRIPE_PRO_LAUNCH_COUPON_ID=coupon_replace_me

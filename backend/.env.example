MONGO_URL=mongodb+srv://user:password@example.mongodb.net
DB_NAME=pipsevo
JWT_SECRET=replace-with-a-long-random-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Secret key used only by the backend. Never expose it with a REACT_APP_ prefix.
SUPABASE_SECRET_KEY=sb_secret_your_server_key
EMERGENT_LLM_KEY=replace-with-your-server-side-ai-key

# MetaTrader 5 automatic sync. Keep OFF until a real provider adapter is
# registered and validated with sandbox credentials.
MT5_AUTO_SYNC_ENABLED=false
MT5_PROVIDER=
MT5_ALLOWED_PLANS=beta,pro
MT5_SYNC_INTERVAL_MINUTES=5
MT5_SYNC_RETRY_ATTEMPTS=3
MT5_SYNC_BACKOFF_SECONDS=1
MT5_MAX_CONNECTION_ATTEMPTS=5
MT5_CONNECTION_ATTEMPT_WINDOW_MINUTES=15
# Comma-separated URL-safe base64 AES-256 keys, ordered by version.
# Generate a 32-byte key outside the repository and store it in the host secret manager.
INTEGRATION_ENCRYPTION_KEYS=
INTEGRATION_ENCRYPTION_KEY_VERSION=1

# Required only when real Stripe billing is implemented server-side.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_ESSENTIAL_PRICE_ID=price_replace_me
STRIPE_PRO_PRICE_ID=price_replace_me
STRIPE_PRO_LAUNCH_COUPON_ID=coupon_replace_me
